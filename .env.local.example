# OpenAI — requerido para el chat de diagnóstico
OPENAI_API_KEY=sk-...

# Resend — requerido para que el formulario de brief-web envíe leads por correo
RESEND_API_KEY=re_...
# Correo interno que recibe cada lead (opcional, por defecto hola@emberlab.mx)
BRIEF_NOTIFICATION_EMAIL=email

# Sanity — token de lectura (rol Viewer) para la vista previa del Studio.
# Se crea en sanity.io/manage → tu proyecto → API → Tokens.
SANITY_API_READ_TOKEN=sk...
